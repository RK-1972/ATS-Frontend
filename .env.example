# Local development (npm run dev)
VITE_API_MODE=live
VITE_API_BASE_URL=http://localhost:5000

# Cloud production (npm run build — uses .env.production, not this file)
# VITE_API_MODE=live
# VITE_API_BASE_URL=https://optalynx-api.onrender.com

# On-premises customer bundle (npm run build:onprem — uses .env.onprem)
# VITE_API_MODE=live
# VITE_API_BASE_URL must stay empty for same-origin IIS routing.
# Do not set customer hostnames in frontend env files.
